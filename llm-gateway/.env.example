# Real provider keys — keep them only here, on the server.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Postgres password (used by docker-compose for both the DB and the app)
POSTGRES_PASSWORD=change-me

# Optional: override model names (LiteLLM format "provider/model")
# CHEAP_MODEL_GEMINI=gemini/gemini-3.8-flash
# CHEAP_MODEL_OPENAI=openai/gpt-5-mini
# STRONG_MODEL_CLAUDE=anthropic/claude-sonnet-5-5
# STRONG_MODEL_OPENAI=openai/gpt-5

# Optional tuning
# CACHE_TTL_SECONDS=86400
# DEFAULT_RPM_LIMIT=60
# COOKIE_SECURE=true   # set when serving over HTTPS
