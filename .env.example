# ---------- LLM providers (keep these only on the server) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=

# ---------- Local docker-compose ----------
POSTGRES_PASSWORD=change-me

# ---------- Production (Render) ----------
# ENVIRONMENT=production
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require   # Neon
# REDIS_URL=rediss://default:pass@xxx.upstash.io:6379                           # Upstash
# COOKIE_SECURE=true

# ---------- Optional tuning ----------
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_LARGE_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash
# TIER_CHEAP=groq-fast,gemini          # order = primary, then fallbacks
# TIER_STRONG=gemini,groq-large
# MODEL_PRICES={"llama-3.1-8b-instant": [0.05, 0.08]}   # USD per 1M tokens [in, out]
# CACHE_TTL_SECONDS=86400
# DEFAULT_RPM_LIMIT=60
